<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/trickystore_title">

    <co.aospa.framework.preference.SystemPropertySwitchPreference
        android:key="persist.sys.trickystore.enabled"
        android:title="@string/ts_master_switch_title"
        android:defaultValue="false" />

    <PreferenceCategory
        android:key="ts_keybox_category"
        android:title="@string/ts_keybox_management"
        android:dependency="persist.sys.trickystore.enabled">

        <Preference
            android:key="ts_fetch_keybox"
            android:title="@string/ts_fetch_keybox"
            android:summary="@string/ts_fetch_keybox_summary" />

        <Preference
            android:key="ts_import_keybox"
            android:title="@string/ts_import_keybox"
            android:summary="@string/ts_no_keybox" />

        <Preference
            android:key="ts_delete_keybox"
            android:title="@string/ts_delete_keybox"
            android:summary="@string/ts_delete_keybox_summary" />

        <Preference
            android:key="ts_revocation_status"
            android:title="@string/ts_revocation_status"
            android:summary="@string/ts_revocation_no_keybox"
            android:selectable="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="ts_target_category"
        android:title="@string/ts_target_configuration"
        android:dependency="persist.sys.trickystore.enabled">

        <Preference
            android:key="ts_manage_targets"
            android:title="@string/ts_manage_target_apps"
            android:summary="@string/ts_no_targets"
            settings:controller="com.android.settings.applications.TrickyStoreAppListController"
            android:fragment="com.android.settings.applications.TrickyStoreAppListSettings" />

        <Preference
            android:key="ts_import_targets"
            android:title="@string/ts_import_target_list"
            android:summary="@string/ts_import_target_list_summary" />

        <Preference
            android:key="ts_verification_mode"
            android:title="@string/ts_verification_mode"
            android:summary="@string/ts_verification_mode_auto"
            android:enabled="false"
            android:selectable="false" />

        <Preference
            android:key="ts_security_patch"
            android:title="@string/ts_security_patch"
            android:summary="@string/ts_no_patch" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="ts_footer_category"
        android:title="@string/ts_footer_title">

        <com.android.settingslib.widget.FooterPreference
            android:key="ts_footer"
            android:title="@string/ts_footer_body"
            android:selectable="false" />
    </PreferenceCategory>

</PreferenceScreen>
